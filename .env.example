# ---------------------------------------------------------------------------
# CampusBuzz environment configuration (copy to .env — never commit .env)
# Flutter reads values via --dart-define / --dart-define-from-file=.env.json
# Cloud Functions read secrets via `firebase functions:secrets:set`.
# ---------------------------------------------------------------------------

# Flutter runtime -----------------------------------------------------------
# development | staging | production
CB_ENV=development
# true = connect to the Firebase Emulator Suite (localhost). NEVER true in production builds.
USE_EMULATORS=true
# Host used when running on a physical device against the emulator (e.g. 192.168.1.10)
EMULATOR_HOST=localhost
# Optional: Google Maps static/JS key for venue previews (falls back to "Open in Maps").
GOOGLE_MAPS_API_KEY=
# Optional: PostHog project key. App works without it (first-party analytics still recorded).
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
# Web reCAPTCHA v3 site key for App Check (web only)
APP_CHECK_WEB_RECAPTCHA_KEY=
# Public base URL used for shareable deep links
DEEP_LINK_BASE_URL=https://campusbuzz.app

# Cloud Functions secrets (set with: firebase functions:secrets:set QR_SIGNING_SECRET) ----
# 32+ random bytes, base64. Used to HMAC-sign rotating check-in QR tokens.
QR_SIGNING_SECRET=
# Optional server-side PostHog key
POSTHOG_SERVER_KEY=

# Emulator-only seed configuration --------------------------------------------
SEED_CAMPUS_DOMAIN=demo.campusbuzz.test
